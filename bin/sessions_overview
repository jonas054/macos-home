#!/usr/bin/env python3
"""
sessions_overview - Generate an HTML overview of all Copilot session events.html files.

Reads all ~/.copilot/session-state/*/events.html files and produces
~/.copilot/session-state/sessions-overview.html with links and first user prompts.
"""

import base64
import glob
import html
import json
import os
