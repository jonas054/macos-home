#!/usr/bin/env ruby
#
require 'find'
require 'fileutils'

def main
  dirs, min_size, rm_flag, rm_regexp, format = parse_args

  table = Hash.new []
  find_files dirs, min_size, table

  table.sort_by { |size, paths| paths }.each { |size, paths|
    paths.uniq!
    paths.each_with_index { |path1, ix1|
      paths[(ix1+1)..-1].each { |path2|
        if rm_regexp
          matches, non_matches = [path1, path2].partition { |p| p =~ rm_regexp }
          next if matches.size != 1
          match = rm_flag == '--rm' ? matches[0] : non_matches[0]
        end
        if same_contents size, path1, path2
          if format == :one_line
            puts "#{path1} and #{path2} are identical"
          else
            puts "Identical:", "  " + `ls -l "#{path1}"`,"  " + `ls -l "#{path2}"`
          end
          if rm_regexp
            if matches.size == 1
              if File.basename(path1) == File.basename(path2)
                remove :unconditional, match
              else
                remove :different_names, match # identical but with different names
              end
            end
          elsif rm_flag == '--ask'
            remove :ask, path1 unless remove :ask, path2
          end
        end
      }
    }
  }
end

def find_files(dirs, min_size, table)
  dirs.map { Dir["#{_1}/.*"] + Dir["#{_1}/*"] }.flatten.each { |child|
    next if child.end_with?('/.') or File.symlink? child
    next unless File.readable? child

    # Skip Apple Photos library package, which will contain many files
    # with identical contents (e.g. "originals" and "modified"
    # versions of the same photo).
    next if child =~ /Photos Library\.photoslibrary/
    # Problematic directory on MacOS.
    next if File.join(Dir.pwd, child) =~ /Library\/Containers/

    if File.directory?(child)
      find_files [child], min_size, table
    elsif File.size(child) >= min_size
      table[File.size(child)] += [child]
    end
  }
end

def parse_args
  dirs = []
  min_size = 5
  format = :one_line

  while ARGV.any?
    case ARGV.first
    when '--rm', '--keep'
      rm_flag = ARGV.shift
      rm_regexp = Regexp.new ARGV.first
    when '--ask'
      rm_flag = ARGV.first
    when '-f'
      format = :more_readable
    when '-s'
      ARGV.shift
      min_size = ARGV.first.gsub(/_/, '').to_i
    when /^-/
      usage
    else
      dirs << ARGV.first.chomp('/').chomp('\\')
    end
    ARGV.shift
  end
  dirs = ['.'] if dirs.empty?
  [dirs, min_size, rm_flag, rm_regexp, format]
end

def usage
  puts "Usage: find_identical [{--rm|--keep} <pattern>] [-s <min_size>] [<dirs>]"
  puts "       find_identical --ask [-s <min_size>] [<dirs>]"
  exit
end

def same_contents(size, path1, path2)
  return false unless File.exist? path1 and File.exist? path2
  block = 1024 * 1024
  0.step(size, block) { |offs|
    return false if IO.read(path1, block, offs) != IO.read(path2, block, offs)
  }
  true
end

def remove(mode, path)
  while mode == :ask || mode == :different_names and not @yes_to_all and not @no_to_all
    print "Remove #{path} y(es)/n(o)/A(ll)"
    print "/N(one with different names)" if mode == :different_names
    print "? "
    case ($stdin.gets || 'N').strip
    when 'y' then break
    when 'n' then return false
    when 'A' then @yes_to_all = true
    when 'N' then @no_to_all = true
    end
  end
  return false if @no_to_all and mode == :different_names
  FileUtils.rm path
  puts "Removed #{path}" if mode == :unconditional or @yes_to_all
  true
end

main if $PROGRAM_NAME == __FILE__
