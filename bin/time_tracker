#!/usr/bin/env ruby

IDLE_THRESHOLD = 120  # Gräns för inaktivitet i sekunder
CHECK_INTERVAL = 10  # Intervall för mätning i sekunder

def idle_seconds
  raw = `ioreg -c IOHIDSystem | awk '/HIDIdleTime/ {print $NF; exit}'`.strip.to_i
  raw / 1_000_000_000.0
end

ANSI_CLEAR_SCREEN = "\e[2J\e[H"

active_time = 0
total_idle_time = 0
total_time = 0

puts "Mäter aktiv tid vid tangentbord/mus. Tryck Ctrl+C för att avsluta."

def format_time(seconds)
  mins, secs = seconds.divmod(60)
  hrs, mins = mins.divmod(60)
  text = hrs > 0 ? "#{hrs} timmar " : ''
  text += "#{mins} min #{secs} s = #{(seconds / 3600.0).round(2)} timmar".sub('.', ',')
end

begin
  loop do
    mins, secs = active_time.divmod(60)
    hrs, mins = mins.divmod(60)
    puts "#{ANSI_CLEAR_SCREEN}Aktiv:   #{format_time(active_time)}"
    mins, secs = total_idle_time.divmod(60)
    hrs, mins = mins.divmod(60)
    puts "Inaktiv: #{format_time(total_idle_time)}" if total_idle_time > 0
    puts "Totalt:  #{format_time(total_time)}"

    if idle_seconds < IDLE_THRESHOLD
      active_time += CHECK_INTERVAL
    else
      total_idle_time += CHECK_INTERVAL
    end
    total_time += CHECK_INTERVAL
    sleep CHECK_INTERVAL
  end
rescue Interrupt
  mins, secs = active_time.divmod(60)
  puts "\nAvslutat. Arbetspass: #{mins} minuter och #{secs} sekunder."
end
