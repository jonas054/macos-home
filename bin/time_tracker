#!/usr/bin/env ruby

IDLE_THRESHOLD = 90  # Limit for idle time in seconds
CHECK_INTERVAL = 50  # Limit for how often to check idle time

def idle_seconds
  raw = `ioreg -c IOHIDSystem`.lines.grep(/HIDIdleTime/).last.split.last.to_i
  raw / 1_000_000_000.0
end

ANSI_CLEAR_SCREEN = "\e[2J\e[H"

active_time = 0
total_idle_time = 0
total_time = 0
start_time = Time.now
last_tick = Time.now

def format_time(seconds)
  mins, secs = seconds.round.divmod(60)
  hrs, mins = mins.divmod(60)
  text = hrs > 0 ? "#{hrs} timmar " : ''
  text += "#{mins} min #{secs} s = #{(seconds / 3600.0).round(2)} timmar".sub('.', ',')
end

def percent(time)
  (100 * time / @passed_time).round(1).to_s.sub('.', ',') + ' %'
end

loop do
  @passed_time = Time.now - start_time
  puts ANSI_CLEAR_SCREEN + "Mäter aktiv tid vid tangentbord/mus. Tryck Ctrl+C för att avsluta."
  puts "Aktiv:    #{format_time(active_time)} (#{percent(active_time)})"
  if total_idle_time > 0
    puts "Inaktiv:  #{format_time(total_idle_time)} (#{percent(total_idle_time)})"
  end
  puts "Totalt:   #{format_time(total_time)} (#{percent(total_time)})"
  puts "Förlupen: #{format_time(@passed_time)}"

  sleep CHECK_INTERVAL

  now = Time.now
  elapsed_interval = now - last_tick
  last_tick = now

  # Ignore abnormally long intervals (e.g., system sleep > 2x CHECK_INTERVAL)
  next if elapsed_interval > CHECK_INTERVAL * 2

  if idle_seconds < IDLE_THRESHOLD
    active_time += elapsed_interval
  else
    total_idle_time += elapsed_interval
  end
  total_time += elapsed_interval
end
