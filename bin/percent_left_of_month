#!/usr/bin/env ruby
#
# Calculates the percentage of the month that is elapsed or left,
# based on calendar days and workdays.
#
# Usage:
#   percent_left_of_month [--remaining|-r]
#   percent_left_of_month --test             (Run unit tests)

require 'date'

WORKDAY_START = 8.0
WORKDAY_END   = 17.0
WORKDAY_HOURS = WORKDAY_END - WORKDAY_START

def percent_left_of_month(now = Time.now, only_workdays)
  today = now.to_date
  first = Date.new(today.year, today.month, 1)
  last  = Date.new(today.year, today.month, -1)

  if only_workdays
    month_length = (first..last).count { workday?(_1) }
    days_left = (first..last).count { _1 >= today && workday?(_1) }
  else
    month_length = (last - first + 1).to_f
    days_left = month_length - (today - first).to_f
  end

  # Fraction of today already elapsed based on workday hours (clamped to [0,1])
  time_of_day  = now.hour + now.min / 60.0 + now.sec / 3600.0
  day_fraction = ((time_of_day - WORKDAY_START) / WORKDAY_HOURS).clamp(0.0, 1.0)
  time_left = days_left - day_fraction

  (100.0 * time_left / month_length).round(1)
end

def workday?(date)
  return false if date.saturday? || date.sunday? # Weekends

  easter_sunday = easter_sunday(date.year)
  is_holiday = (is?(date, 1, 1) ||                     # New Year's Day
                is?(date, 1, 6) ||                     # Epiphany
                date == easter_sunday - 2 ||           # Good Friday
                date == easter_sunday + 1 ||           # Easter Monday
                is?(date, 5, 1) ||                     # May Day
                date == easter_sunday + 39 ||          # Ascension Day
                date == easter_sunday + 49 ||          # Pentecost
                is?(date, 6, 6) ||                     # National Day
                (24..26).any? { is?(date, 12, _1) } || # Christmas
                is?(date, 12, 31))                     # New Year's Eve
  !is_holiday
end

def easter_sunday(year)
  a = year % 19
  b = year / 100
  c = year % 100
  h = (19 * a + b - (b / 4) - ((b - (b + 8) / 25 + 1) / 3) + 15) % 30
  l = (32 + 2 * (b % 4) + 2 * (c / 4) - h - c % 4) % 7
  m = (a + 11 * h + 22 * l) / 451

  Date.new(year, (h + l - 7 * m + 114) / 31, ((h + l - 7 * m + 114) % 31) + 1)
end

def is?(date, month, day)
  date == Date.new(date.year, month, day)
end

def report(only_workdays, show_remaining_time)
  which_days = only_workdays ? 'workdays' : 'calendar days'
  legend = show_remaining_time ? "left of the month (#{which_days})" : "elapsed of the month (#{which_days})"
  percent_left = percent_left_of_month(only_workdays)
  percent = show_remaining_time ? percent_left : (100.0 - percent_left).round(1)
  puts "#{percent}% #{legend}"
end

puts Time.now.strftime('%Y-%m-%d (%A) %H:%M:%S')
show_remaining_time = %w[-r --remaining].any? { ARGV.include?(_1) }
report(false, show_remaining_time)
report(true, show_remaining_time)

# Run tests if --test flag is given
# ----------------------------------------------------------------------

if ARGV.include?('--test')
  ARGV.shift
  require 'test/unit'
  class PercentLeftOfMonthTest < Test::Unit::TestCase
    def test_workdays
      assert_equal(100.0, percent_left_of_month(Time.new(2026, 4, 1, 8, 0, 0), true))
      assert_equal(86.5, percent_left_of_month(Time.new(2026, 4, 7, 14, 15, 0), true))
      assert_equal(5.0, percent_left_of_month(Time.new(2026, 4, 29, 17, 0, 0), true))
      assert_equal(0.0, percent_left_of_month(Time.new(2026, 4, 30, 17, 0, 0), true))
    end

    def test_calendar_days
      assert_equal(100.0, percent_left_of_month(Time.new(2026, 4, 1, 8, 0, 0), false))
      assert_equal(77.7, percent_left_of_month(Time.new(2026, 4, 7, 14, 15, 0), false))
      assert_equal(3.3, percent_left_of_month(Time.new(2026, 4, 29, 17, 0, 0), false))
      assert_equal(0.0, percent_left_of_month(Time.new(2026, 4, 30, 17, 0, 0), false))
    end
  end
end
