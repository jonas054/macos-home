#!/usr/bin/env ruby
#

USAGE = <<~USAGE
  Usage: percent_of_month [-r|--remaining] [-h|--help] [--test]

  Outputs the percentage of the current month that has elapsed or is remaining,
  based on both calendar days and workdays (Mon–Fri, excluding Swedish public holidays).

  Options:
    -r, --remaining   Show percentage remaining (default: elapsed)
    --test            Run unit tests
    -h, --help        Show this help message
USAGE

require 'date'

WORKDAY_START = 8.0
WORKDAY_END   = 17.0
WORKDAY_HOURS = WORKDAY_END - WORKDAY_START

if %w[-h --help].any? { |arg| ARGV.include?(arg) }
  puts USAGE
  exit
end

def percent_left_of_month(now = Time.now, only_workdays)
  today = now.to_date
  first = Date.new(today.year, today.month, 1)
  last  = Date.new(today.year, today.month, -1)

  if only_workdays
    month_length = (first..last).count { |date| workday?(date) }
    days_left = (first..last).count { |date| date >= today && workday?(date) }
  else
    month_length = (last - first + 1).to_f
    days_left = month_length - (today - first).to_f
  end

  # Fraction of today already elapsed based on workday hours (clamped to [0,1])
  time_of_day  = now.hour + now.min / 60.0 + now.sec / 3600.0
  day_fraction = ((time_of_day - WORKDAY_START) / WORKDAY_HOURS).clamp(0.0, 1.0)
  time_left = days_left - day_fraction

  (100.0 * time_left / month_length).round(1)
end

def workday?(date)
  !(date.saturday? || date.sunday? || holiday?(date))
end

def holiday?(date)
  easter_sunday = easter_sunday(date.year)
  is?(date, 1, 1) ||                          # New Year's Day
    is?(date, 1, 6) ||                        # Epiphany
    date == easter_sunday - 2 ||              # Good Friday
    date == easter_sunday + 1 ||              # Easter Monday
    is?(date, 5, 1) ||                        # May Day
    date == easter_sunday + 39 ||             # Ascension Day
    is?(date, 6, 6) ||                        # National Day
    date == midsummers_eve(date.year) ||      # Midsummer's Eve
    (24..26).any? { |d| is?(date, 12, d) } || # Christmas
    is?(date, 12, 31)                         # New Year's Eve
end

def easter_sunday(year)
  aa = year % 19
  century = year / 100
  year_two_digits = year % 100
  hh = (19 * aa +
        century -
        (century / 4) -
        ((century - (century + 8) / 25 + 1) / 3) +
        15) % 30
  ll = (32 +
        2 * (century % 4) +
        2 * (year_two_digits / 4) -
        hh -
        year_two_digits % 4) % 7
  mm = (aa + 11 * hh + 22 * ll) / 451
  xx = hh + ll - 7 * mm + 114

  Date.new(year, xx / 31, (xx % 31) + 1)
end

def midsummers_eve(year)
  # Midsummer's Eve is the Friday between June 19 and June 25
  (19..25).each do |day|
    date = Date.new(year, 6, day)
    return date if date.friday?
  end
end

def is?(date, month, day)
  date == Date.new(date.year, month, day)
end

def report(only_workdays, show_remaining_time, now = Time.now)
  percent_left = percent_left_of_month(now, only_workdays)
  percent = show_remaining_time ? percent_left : (100.0 - percent_left).round(1)
  direction = show_remaining_time ? 'remaining' : 'elapsed'
  which_days = only_workdays ? 'workdays' : 'calendar days'
  "#{percent}% #{direction} of the month (#{which_days})"
end

puts Time.now.strftime('%Y-%m-%d (%A) %H:%M:%S')
show_remaining_time = %w[-r --remaining].any? { |arg| ARGV.include?(arg) }
puts report(false, show_remaining_time)
puts report(true, show_remaining_time)

# Run tests if --test flag is given
# ----------------------------------------------------------------------

if ARGV.include?('--test')
  ARGV.shift
  require 'test/unit'
  class PercentLeftOfMonthTest < Test::Unit::TestCase
    def test_workdays
      assert_equal(100.0, percent_left_of_month(Time.new(2026, 4, 1, 8, 0, 0), true))
      assert_equal(86.5, percent_left_of_month(Time.new(2026, 4, 7, 14, 15, 0), true))
      assert_equal(5.0, percent_left_of_month(Time.new(2026, 4, 29, 17, 0, 0), true))
      assert_equal(0.0, percent_left_of_month(Time.new(2026, 4, 30, 17, 0, 0), true))
    end

    def test_calendar_days
      assert_equal(100.0, percent_left_of_month(Time.new(2026, 4, 1, 8, 0, 0), false))
      assert_equal(77.7, percent_left_of_month(Time.new(2026, 4, 7, 14, 15, 0), false))
      assert_equal(3.3, percent_left_of_month(Time.new(2026, 4, 29, 17, 0, 0), false))
      assert_equal(0.0, percent_left_of_month(Time.new(2026, 4, 30, 17, 0, 0), false))
    end

    def test_easter_sunday
      assert_equal(Date.new(2026, 4, 5), easter_sunday(2026))
      assert_equal(Date.new(2027, 3, 28), easter_sunday(2027))
      assert_equal(Date.new(2028, 4, 16), easter_sunday(2028))
      assert_equal(Date.new(2029, 4, 1), easter_sunday(2029))
      assert_equal(Date.new(2030, 4, 21), easter_sunday(2030))
      assert_equal(Date.new(2031, 4, 13), easter_sunday(2031))
    end

    def test_workday
      assert(workday?(Date.new(2026, 4, 1))) # Wednesday
      assert(workday?(Date.new(2026, 4, 2))) # Thursday
      assert(!workday?(Date.new(2026, 4, 3))) # Good Friday
      assert(!workday?(Date.new(2026, 4, 4))) # Easter Saturday
      assert(!workday?(Date.new(2026, 4, 5))) # Easter Sunday
      assert(!workday?(Date.new(2026, 4, 6))) # Easter Monday
      assert(workday?(Date.new(2026, 4, 7))) # Tuesday
      assert(!workday?(Date.new(2026, 5, 14))) # Ascension Day
      assert(workday?(Date.new(2026, 5, 15))) # Squeeze day
    end

    def test_report_calendar_days_remaining
      assert_equal("100.0% remaining of the month (calendar days)",
                   report(false, true, Time.new(2026, 4, 1, 8, 0, 0)))
      assert_equal("77.7% remaining of the month (calendar days)",
                   report(false, true, Time.new(2026, 4, 7, 14, 15, 0)))
      assert_equal("3.3% remaining of the month (calendar days)",
                   report(false, true, Time.new(2026, 4, 29, 17, 0, 0)))
      assert_equal("0.0% remaining of the month (calendar days)",
                   report(false, true, Time.new(2026, 4, 30, 17, 0, 0)))
    end

    def test_report_workdays_remaining
      assert_equal("100.0% remaining of the month (workdays)",
                   report(true, true, Time.new(2026, 4, 1, 8, 0, 0)))
      assert_equal("86.5% remaining of the month (workdays)",
                   report(true, true, Time.new(2026, 4, 7, 14, 15, 0)))
      assert_equal("5.0% remaining of the month (workdays)",
                   report(true, true, Time.new(2026, 4, 29, 17, 0, 0)))
      assert_equal("0.0% remaining of the month (workdays)",
                   report(true, true, Time.new(2026, 4, 30, 17, 0, 0)))
    end

    def test_report_calendar_days_elapsed
      assert_equal("0.0% elapsed of the month (calendar days)",
                   report(false, false, Time.new(2026, 4, 1, 8, 0, 0)))
      assert_equal("22.3% elapsed of the month (calendar days)",
                   report(false, false, Time.new(2026, 4, 7, 14, 15, 0)))
      assert_equal("96.7% elapsed of the month (calendar days)",
                   report(false, false, Time.new(2026, 4, 29, 17, 0, 0)))
      assert_equal("100.0% elapsed of the month (calendar days)",
                   report(false, false, Time.new(2026, 4, 30, 17, 0, 0)))
    end

    def test_report_workdays_elapsed
      assert_equal("0.0% elapsed of the month (workdays)",
                   report(true, false, Time.new(2026, 4, 1, 8, 0, 0)))
      assert_equal("13.5% elapsed of the month (workdays)",
                   report(true, false, Time.new(2026, 4, 7, 14, 15, 0)))
      assert_equal("95.0% elapsed of the month (workdays)",
                   report(true, false, Time.new(2026, 4, 29, 17, 0, 0)))
      assert_equal("100.0% elapsed of the month (workdays)",
                   report(true, false, Time.new(2026, 4, 30, 17, 0, 0)))
    end
  end
end
